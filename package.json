{
  "name": "dsh-hierarchical-fishmemory",
  "version": "1.3.1",
  "description": "属于我们的回忆：分层记忆插件，一个包全管。共度时光（经过，diary 引擎）、情感日记（我自己的感受）、人格手记（每轮注入的性格与嘱托）、浅层记忆（带 7 天 TTL）、人格档案。2026-10-31 由 feiyu-memory 4.0.2 + dsh-shallow-memory + dsh-soul-md 收编而来。",
  "type": "module",
  "license": "MIT",
  "author": "dsh-hierarchical-fishmemory contributors",
  "exports": {
    ".": "./src/host/index.mjs",
    "./soul": "./src/soul/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "src",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SPEC.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "test": "node --test",
    "build:client": "node tools/build-client.mjs",
    "check:client": "node tools/build-client.mjs --check"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "persona",
    "diary"
  ],
  "publishConfig": {
    "access": "public"
  },
  "private": true,
  "contributors": [
    "空气凤梨（上游 feiyu-memory 作者）"
  ]
}

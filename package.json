{
  "name": "dsh-hierarchical-fishmemory",
  "version": "1.21.1",
  "description": "面向 DeepSeek Harness 的分层长期记忆：共度时光（自动蒸馏的经过，会随时间衰减）、情感日记（手写感受，不衰减）、人格手记（每轮全量注入）、浅层记忆（7 天 TTL）与人设卡（带版本历史）共用一份 token 预算，配召回、体检、压缩与整包备份还原。一个包全管。",
  "type": "module",
  "license": "MIT",
  "author": "dsh-hierarchical-fishmemory contributors",
  "exports": {
    ".": "./src/host/index.mjs",
    "./soul": "./src/soul/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "src",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SPEC.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "test": "node --test",
    "build:client": "node tools/build-client.mjs",
    "check:client": "node tools/build-client.mjs --check"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "persona",
    "diary"
  ],
  "publishConfig": {
    "access": "public"
  },
  "contributors": [
    "空气凤梨（上游 feiyu-memory 作者）"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarsStorm/dsh-hierarchical-fishmemory.git"
  },
  "homepage": "https://github.com/MarsStorm/dsh-hierarchical-fishmemory#readme",
  "bugs": {
    "url": "https://github.com/MarsStorm/dsh-hierarchical-fishmemory/issues"
  }
}
